# ==============================================================================
# NexusPOS Desktop - Configuración de Entorno
# ==============================================================================

# URL de la API de Laravel (Autenticación y Cuentas Principales desde la Landing Page)
# Cuando tu API en Laravel esté en ejecución, ajusta esta URL:
# - Desarrollo local estándar: http://127.0.0.1:8000/api/v1
# - Con Laragon / Valet virtual host: http://nexuspos-api.test/api/v1
# - Servidor de pruebas / Staging: https://staging-api.nexuspos.pe/api/v1
# - Producción: https://api.nexuspos.pe/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXUS_API_URL=http://127.0.0.1:8000/api/v1

# Identificador de la Estación POS actual
VITE_DEFAULT_STATION=CAJA-01

# Modo de operación ('hybrid' = intenta Laravel primero, luego SQLite local; 'local' = solo SQLite)
VITE_AUTH_MODE=hybrid
